                                ;; ======================================================================== ;;
                                ;;  FILLZERO                                                                ;;
                                ;;      Fills memory with zeros                                             ;;
                                ;;                                                                          ;;
                                ;;  FILLMEM                                                                 ;;
                                ;;      Fills memory with a constant                                        ;;
                                ;;                                                                          ;;
                                ;;  INPUTS:                                                                 ;;
                                ;;      R0 -- Fill value (FILLMEM only)                                     ;;
                                ;;      R1 -- Number of words to fill                                       ;;
                                ;;      R4 -- Start of fill area                                            ;;
                                ;;      R5 -- Return address                                                ;;
                                ;;                                                                          ;;
                                ;;  OUTPUTS:                                                                ;;
                                ;;      R0 -- Zeroed if FILLZERO, otherwise untouched.                      ;;
                                ;;      R1 -- Zeroed                                                        ;;
                                ;;      R4 -- Points to word after fill area                                ;;
                                ;; ======================================================================== ;;
0x50B4                          CLRSCR      PROC
50B4   02B9 00F0                            MVII    #$0F0,  R1
50B6   02BC 0200                            MVII    #$200,  R4
50B8   01C0                     FILLZERO    CLRR    R0              ; Start out with R0 zeroed for FILLZERO
50B9   0260                     FILLMEM     MVO@    R0,     R4      ; Store R0 out at R4, and move along
50BA   0011                                 DECR    R1              ; Keep going until our count runs out
50BB   022C 0003                            BNEQ    FILLMEM
50BD   00AF                                 JR      R5              ; Return to the caller.
                                            ENDP

                                ;; ======================================================================== ;;
                                ;;  End of File:  fillzero.asm                                              ;;
                                ;; ======================================================================== ;;
                                        INCLUDE "../../library/memcpy.asm"
                                ;* ======================================================================== *;
                                ;*  The routines and data in this file (memcpy.asm) are dedicated to the    *;
                                ;*  public domain via the Creative Commons CC0 v1.0 license by its author,  *;
                                ;*  Joseph Zbiciak.                                                         *;
                                ;*                                                                          *;
                                ;*          https://creativecommons.org/publicdomain/zero/1.0/              *;
                                ;* ======================================================================== *;

                                ;; ======================================================================== ;;
                                ;;  MEMCPY    Copy one array to another                                     ;;
                                ;;  MEMCPY.1  Alternate entry point                                         ;;
                                ;;                                                                          ;;
                                ;;  AUTHOR                                                                  ;;
                                ;;      Joseph Zbiciak <intvnut AT gmail.com>                               ;;
                                ;;                                                                          ;;
                                ;;  REVISION HISTORY                                                        ;;
                                ;;      08-Sep-2001 Initial Revision                                        ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for MEMCPY                                                       ;;
                                ;;      R5    Pointer to invocation record, followed by return address.     ;;
                                ;;            Pointer to destination       1 DECLE                          ;;
                                ;;            Pointer to source            1 DECLE                          ;;
                                ;;            Length                       1 DECLE                          ;;
                                ;;                                                                          ;;
                                ;;  INPUTS for MEMCPY.1                                                     ;;
                                ;;      R5    Return address                                                ;;
                                ;;      R4    Pointer to destination                                        ;;
                                ;;      R1    Pointer to source                                             ;;
                                ;;      R0    Length                                                        ;;
                                ;;                                                                          ;;
                                ;;  OUTPUTS                                                                 ;;
                                ;;      R0    $FFFF                                                         ;;
                                ;;      R1    Last element copied                                           ;;
                                ;;      R4    Points one element beyond destination array                   ;;
                                ;;      R5    Points one element beyond source array                        ;;
                                ;;                                                                          ;;
                                ;;  TECHNIQUES                                                              ;;
                                ;;      Unrolled 8x for speed.                                              ;;
                                ;;      Special dispatch handles length % 8 != 0.                           ;;
                                ;;                                                                          ;;
                                ;;  CODESIZE                                                                ;;
                                ;;      35 words                                                            ;;
                                ;;                                                                          ;;
                                ;;  CYCLES                                                                  ;;
                                ;;      Not yet characterized.                                              ;;
                                ;; ======================================================================== ;;
0x50BE                          MEMCPY      PROC

50BE   02AC                                 MVI@    R5,     R4      ;   8   Destination array
50BF   02A9                                 MVI@    R5,     R1      ;   8   Source array
50C0   02A8                                 MVI@    R5,     R0      ;   8   Length

50C1   0275                     @@1:        PSHR    R5              ;   9   Alternate entry point

50C2   008D                                 MOVR    R1,     R5      ;   6   Use auto-incr pointer

50C3   0081                                 MOVR    R0,     R1      ;   6   Copy array length
50C4   0064                                 SLR     R0,     2       ;   8   \___ Find floor(length / 8)
50C5   0060                                 SLR     R0,     1       ;   6   /
50C6   03B9 0007                            ANDI    #7,     R1      ;   8   \
50C8   00C9                                 ADDR    R1,     R1      ;   6    |__ Find address to jump to for
50C9   0339 50DD                            SUBI    #@@end, R1      ;   8    |   first iteration, to handle
50CB   0021                                 NEGR    R1              ;   6   /    length % 8.
50CC   008F                                 MOVR    R1,     PC      ;   6   Jump into copy loop.


50CD   02A9                     @@loop:     MVI@    R5,     R1      ;   8   
50CE   0261                                 MVO@    R1,     R4      ;   9   
50CF   02A9                                 MVI@    R5,     R1      ;   8   
50D0   0261                                 MVO@    R1,     R4      ;   9   
50D1   02A9                                 MVI@    R5,     R1      ;   8   
50D2   0261                                 MVO@    R1,     R4      ;   9   
50D3   02A9                                 MVI@    R5,     R1      ;   8   
50D4   0261                                 MVO@    R1,     R4      ;   9   
50D5   02A9                                 MVI@    R5,     R1      ;   8   
50D6   0261                                 MVO@    R1,     R4      ;   9   
50D7   02A9                                 MVI@    R5,     R1      ;   8   
50D8   0261                                 MVO@    R1,     R4      ;   9   
50D9   02A9                                 MVI@    R5,     R1      ;   8   
50DA   0261                                 MVO@    R1,     R4      ;   9   
50DB   02A9                                 MVI@    R5,     R1      ;   8   
50DC   0261                                 MVO@    R1,     R4      ;   9   
                                            
50DD   0010                     @@end:      DECR    R0              ;   6   
50DE   0223 0012                            BPL     @@loop          ;  9/7  Iterate floor(length/8) + 1 times
                                                                    ;----
                                                                    ; 151*k - 2

50E0   02B7                     @@done:     PULR    PC              ;  11   Return
                                            ENDP    


