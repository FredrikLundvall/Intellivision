00000000 MEMMAP                     000001F0 PSG0                       
000000F0 PSG1                       00000000 PSG                        
00000000 STIC                       00000100 SCRATCH                    
00000100 ISRVEC                     00000102 INPUT                      
00000103 FRAME                      00000104 HITS                       
000002F0 SYSTEM                     000002F0 STACK                      
00000310 PLAYER_X                   00000311 PLAYER_Y                   
00000312 ENEMY_X                    00000313 ENEMY_Y                    
00000314 PLAYER_A                   00000315 ENEMY_A                    
00005000 ROMHDR                     0000500D ZERO                       
00005028 MAIN                       00005014 ONES                       
00005015 TITLE                      00005088 VBLANK_ISR                 
00005062 INIT                       00005036 MAIN.loop                  
00005048 MAIN.enemy                 00005059 MAIN.check                 
00005057 MAIN.enemy_save            000050B9 FILLMEM                    
000050BE MEMCPY                     000050AC PLAYER_GFX                 
000050B4 CLRSCR                     000050B8 FILLZERO                   
000050C1 MEMCPY.1                   000050DD MEMCPY.end                 
000050CD MEMCPY.loop                000050E0 MEMCPY.done                
                                ; Learning Game Level 4: two MOBs, frame timing, and interaction state.
                                        CFGVAR  "name" = "Learning Game 4 - Collision"
                                        CFGVAR  "short_name" = "Learning 4"
                                        CFGVAR  "description" = "Move a player toward a patrol enemy."
                                        ROMW    16
                                        INCLUDE "../../library/gimini.asm"
                                ;* ======================================================================== *;
                                ;*  The routines and data in this file (gimini.asm) are dedicated to the    *;
                                ;*  public domain via the Creative Commons CC0 v1.0 license by its author,  *;
                                ;*  Joseph Zbiciak.                                                         *;
