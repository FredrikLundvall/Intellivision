0x100                           SCRATCH ORG     $100, $100, "-RWBN"
0x100                           ISRVEC  RMB     2
0x102                           INPUT   RMB     1
0x103                           FRAME   RMB     1
0x104                           HITS    RMB     1
0x2F0                           SYSTEM  ORG     $2F0, $2F0, "-RWBN"
0x2F0                           STACK   RMB     32
0x310                           PLAYER_X RMB    1
0x311                           PLAYER_Y RMB    1
0x312                           ENEMY_X  RMB    1
0x313                           ENEMY_Y  RMB    1
0x314                           PLAYER_A RMB   1
0x315                           ENEMY_A  RMB     1

0x5000                                  ORG     $5000
5000   000D 0050                ROMHDR: BIDECLE ZERO
5002   000D 0050                        BIDECLE ZERO
5004   0028 0050                        BIDECLE MAIN
5006   000D 0050                        BIDECLE ZERO
5008   0014 0050                        BIDECLE ONES
500A   0015 0050                        BIDECLE TITLE
500C   03C0                             DECLE   $03C0
500D   0000 0000                ZERO:   DECLE   0, 0
500F   0001 0001 0001 0001              DECLE   C_BLU, C_BLU, C_BLU, C_BLU, C_BLU
5013   0001 
5014   0001                     ONES:   DECLE   1
0x5015                          TITLE:  PROC
5015   0066 004C 0065 0061              BYTE    102, "Learning Game 4", 0
5019   0072 006E 0069 006E 0067 0020 0047 0061 
5021   006D 0065 0020 0034 0000 
5026   0275                             BEGIN
5027   02B7                             RETURN
                                        ENDP

0x5028                          MAIN:   PROC
5028   0003                             DIS
5029   02BE 02F0                        MVII    #STACK, R6
502B   02B8 5088                        MVII    #VBLANK_ISR, R0
502D   0240 0100                        MVO     R0, ISRVEC
502F   0040                             SWAP    R0
5030   0240 0101                        MVO     R0, ISRVEC+1
5032   0004 0150 0062                   CALL    INIT
5035   0002                             EIS
0x5036                          @@loop:
5036   0280 01FF                        MVI     $01FF, R0
5038   03F8 00FF                        XORI    #$00FF, R0
503A   03B8 00FF                        ANDI    #$00FF, R0
503C   0240 0102                        MVO     R0, INPUT
503E   0280 0102                        MVI     INPUT, R0
5040   0080                             TSTR    R0
5041   0204 0005                        BEQ     @@enemy
5043   0281 0310                        MVI     PLAYER_X, R1
5045   0009                             INCR    R1
5046   0241 0310                        MVO     R1, PLAYER_X
0x5048                          @@enemy:
5048   0280 0103                        MVI     FRAME, R0
504A   03B8 0003                        ANDI    #3, R0
504C   020C 000B                        BNEQ    @@check
504E   0281 0312                        MVI     ENEMY_X, R1
5050   0009                             INCR    R1
5051   0379 0090                        CMPI    #$0090, R1
5053   0209 0002                        BNC     @@enemy_save
5055   02B9 0040                        MVII    #$0040, R1
0x5057                          @@enemy_save:
5057   0241 0312                        MVO     R1, ENEMY_X
0x5059                          @@check:
5059   0280 0104                        MVI     HITS, R0
505B   0224 0026                        BEQ     @@loop
505D   01C0                             CLRR    R0
505E   0240 0104                        MVO     R0, HITS
5060   0220 002B                        B       @@loop
                                        ENDP

0x5062                          INIT:   PROC
5062   02BC 0200                        MVII    #$0200, R4
5064   02B9 00F0                        MVII    #$00F0, R1
5066   02B8 1352                        MVII    #$1352, R0
5068   0004 0150 00B9                   CALL    FILLMEM
506B   0004 0150 00BE                   CALL    MEMCPY
506E   3800 50AC 0008                   DECLE   $3800, PLAYER_GFX, 8
5071   02B8 033C                        MVII    #STIC.mobx_visb + STIC.mobx_intr + 60, R0
5073   0240 0310                        MVO     R0, PLAYER_X
5075   02B8 036E                        MVII    #STIC.mobx_visb + STIC.mobx_intr + 110, R0
5077   0240 0312                        MVO     R0, ENEMY_X
5079   02B8 0132                        MVII    #STIC.moby_ysize2 + 50, R0
507B   0240 0311                        MVO     R0, PLAYER_Y
507D   0240 0313                        MVO     R0, ENEMY_Y
507F   02B8 0802                        MVII    #STIC.moba_gram + STIC.moba_fg2, R0
5081   0240 0314                        MVO     R0, PLAYER_A
5083   02B8 0801                        MVII    #STIC.moba_gram + STIC.moba_fg1, R0
5085   0240 0315                        MVO     R0, ENEMY_A
5087   00AF                             JR      R5
                                        ENDP

0x5088                          VBLANK_ISR PROC
5088   0240 0020                        MVO     R0, $0020
508A   0280 0310                        MVI     PLAYER_X, R0
508C   0240 0000                        MVO     R0, STIC.mob0_x
508E   0280 0312                        MVI     ENEMY_X, R0
5090   0240 0001                        MVO     R0, STIC.mob1_x
5092   0280 0311                        MVI     PLAYER_Y, R0
5094   0240 0008                        MVO     R0, STIC.mob0_y
5096   0280 0313                        MVI     ENEMY_Y, R0
5098   0240 0009                        MVO     R0, STIC.mob1_y
509A   0280 0314                        MVI     PLAYER_A, R0
509C   0240 0010                        MVO     R0, STIC.mob0_a
509E   0280 0315                        MVI     ENEMY_A, R0
50A0   0240 0011                        MVO     R0, STIC.mob1_a
50A2   0280 0018                        MVI     STIC.mob0_c, R0
50A4   0240 0104                        MVO     R0, HITS
50A6   0280 0103                        MVI     FRAME, R0
50A8   0008                             INCR    R0
50A9   0240 0103                        MVO     R0, FRAME
